// XML format for ZebraLogic task
// Structure: <response><reasoning>...</reasoning><answer>A|B|C|D|E|F</answer></response>

start: "<response>" _WS? reasoning _WS? answer _WS? "</response>" _WS?

reasoning: "<reasoning>" text "</reasoning>"
answer: "<answer>" LETTER "</answer>"

// Text content (no < or > allowed)
text: /[^<>]+/

// Single letter A-F
LETTER: /[A-F]/

// Whitespace
_WS: /[ \t\n]+/
