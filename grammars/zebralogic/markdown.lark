// Markdown format for ZebraLogic task
// Structure: ## Reasoning\n...\n\n## Answer\nA|B|C|D|E|F

start: reasoning_section _WS? answer_section _WS?

reasoning_section: "## Reasoning" _WS? text
answer_section: "## Answer" _WS? LETTER _WS?

// Text content - lines that don't start with ## (section marker)
text: line+
line: /[^#\n][^\n]*\n?/      // Line starting with non-# char (trailing newline optional)
    | /#[^#\n][^\n]*\n?/     // Line starting with single # (not ##)
    | /#\n/                   // Just # on a line
    | /\n/                    // Empty line

// Single letter A-F
LETTER: /[A-F]/

// Whitespace
_WS: /[ \t\n]+/
